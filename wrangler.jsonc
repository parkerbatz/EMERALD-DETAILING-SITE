{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "emerald-detailing-site",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emerald-bookings",
      "database_id": "cf89bd03-78f4-4bc0-8a94-ddb012759c06"
    }
  ]
}
